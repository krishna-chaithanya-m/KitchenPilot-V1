# KitchenPilot-V1 Environment Configuration Template
# Copy this file to .env and adjust values as needed.
# Note: KitchenPilot-V1 is an offline-capable system and requires no external API keys or secrets.

# Application Environment (development, staging, production)
ENVIRONMENT=development

# Server Network Binding
API_HOST=127.0.0.1
API_PORT=8000

# CORS Configuration
# Comma-separated list of allowed frontend origins (no trailing slashes, no wildcard '*' when credentials are used)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,http://localhost:5500,http://127.0.0.1:5500

# Logging Configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
