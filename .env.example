# KitchenPilot-V1 Environment Configuration Template
# Copy this file to .env and adjust values as needed.
# Note: KitchenPilot-V1 is an offline-capable system and requires no external API keys or secrets.

# Application Environment (development, staging, production)
ENVIRONMENT=development

# Server Network Binding
API_HOST=127.0.0.1
API_PORT=8000

# CORS Configuration
# Comma-separated list of allowed frontend origins (no trailing slashes, no wildcard '*' when credentials/auth are used)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,http://localhost:5500,http://127.0.0.1:5500

# Logging Configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
STRUCTURED_LOGGING=false

# Data Backend Selection ('csv' or 'postgres' — default is 'csv' for zero-dependency local operation)
DATA_BACKEND=csv

# PostgreSQL Database Connection URL (used when DATA_BACKEND=postgres)
# Example format: postgresql+psycopg://username:password@localhost:5432/kitchenpilot
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/kitchenpilot

# Stage D — Dense Semantic Retrieval Configuration
# SEMANTIC_RETRIEVAL_ENABLED defaults to false to preserve exact V1 baseline behavior
SEMANTIC_RETRIEVAL_ENABLED=false
SEMANTIC_MODEL_NAME=BAAI/bge-small-en-v1.5
SEMANTIC_TOP_K=50
TFIDF_TOP_K=50

# Stage E — Production Constraint Engine
CONSTRAINT_ENGINE_ENABLED=true

# Stage F — Learning-to-Rank XGBoost Configuration
# XGBOOST_RANKING_ENABLED defaults to false; falls back deterministically to HybridRanker
XGBOOST_RANKING_ENABLED=false
XGBOOST_MODEL_PATH=models/ranking/xgboost_ranker.json
XGBOOST_FEATURE_SCHEMA_PATH=models/ranking/feature_schema.json
XGBOOST_METADATA_PATH=models/ranking/metadata.json

# Stage G — User Personalization, Authentication & Feedback Configuration
AUTH_ENABLED=true
# In production, AUTH_SECRET_KEY MUST be set to a random, high-entropy key of at least 32 characters
AUTH_SECRET_KEY=REPLACE_WITH_RANDOM_32_PLUS_CHARACTER_SECRET
AUTH_ALGORITHM=HS256
AUTH_TOKEN_EXPIRE_MINUTES=10080
PERSONALIZATION_ENABLED=true
PERSONALIZATION_WEIGHT=0.20
FEEDBACK_ENABLED=true
RECOMMENDATION_HISTORY_ENABLED=true

# Stage H — Production Hardening, Observability & Rate Limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_AUTH_RPM=20
RATE_LIMIT_RECOMMEND_RPM=60
RATE_LIMIT_FEEDBACK_RPM=60
RATE_LIMIT_GLOBAL_RPM=120
METRICS_ENABLED=true
